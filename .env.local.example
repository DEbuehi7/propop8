# Supabase Configuration
# Get these from your Supabase project settings (Project Settings > API)

# Public - safe to expose to frontend
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Private - server-side only, NEVER expose to client
# Found in Project Settings > API > Service role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: WebSocket URL for real-time features (Phase 2)
# WEBSOCKET_URL=wss://your-domain/api/plate8/stream

# State8 / Plate8 system actor (server-side only)
# UUID of the deliberate system user row seeded by migrations/002_seed_state8_system_user.sql.
# Must match that users(id) row exactly. The save route returns 500 if this is unset.
STATE8_SYSTEM_USER_ID=58b69b8d-a2a3-4b85-8f69-fd92553e8e40

# Email delivery (Resend) - server-side only
# Needed by /api/send-report and the Tally webhook fulfillment.
RESEND_API_KEY=
RESEND_FROM=

# Tally webhook - server-side only
# Signing secret from the Tally webhook settings; requests without a valid signature are rejected.
TALLY_SIGNING_SECRET=
# Set to "true" to treat intakes with a payment as paid and fulfil them; otherwise intakes are held.
TALLY_PAYMENT_ENABLED=false

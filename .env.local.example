# .env.local template. Copy to .env.local and fill in on your own machine.
# Names only here: never commit a real value (tests/secretScan.test.ts refuses
# tracked .env files and credential shapes). tests/envExample.test.ts checks
# that every variable the app reads is listed below.
#
# Classes follow docs/security/DATA_CLASSES.md. NEXT_PUBLIC_ values ship to
# the browser; everything else is server-only.

# ---- Supabase: PropOps8 audit project ----------------------------------------
# Public: project URL and anon key (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: bypasses every RLS rule. Server-only; never in the browser, logs or chat.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----------------------------------------------------------------------
# Public: base URL used in emailed links, e.g. https://propops8.com
NEXT_PUBLIC_BASE_URL=
# Public: Tally intake form id used by the calculators' audit handoff.
NEXT_PUBLIC_TALLY_FORM_ID=

# ---- Admin (secret) -------------------------------------------------------------
# 20+ characters, from the password manager.
ADMIN_PASSWORD=
# Signs the admin session cookie. Rotating it ends every open session.
ADMIN_SESSION_SECRET=

# ---- Email: Resend (secret key) ---------------------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "PropOps8 <reports@your-domain>".
RESEND_FROM=
# Where intake notifications go; falls back to RESEND_FROM.
AUDIT_NOTIFY_EMAIL=

# ---- Tally webhook --------------------------------------------------------------
# Secret: requests without a valid signature are rejected.
TALLY_SIGNING_SECRET=
# "true" treats intakes with a payment as paid and fulfils them; otherwise they are held.
TALLY_PAYMENT_ENABLED=false

# ---- Plate8 / State8 --------------------------------------------------------------
# Deliberate system actor: must equal the users(id) row seeded by
# migrations/002_seed_state8_system_user.sql. The save route returns 500 if unset.
STATE8_SYSTEM_USER_ID=58b69b8d-a2a3-4b85-8f69-fd92553e8e40
# Plate8's own Supabase project. Until both are set, Plate8 writes to the audit project.
PLATE8_SUPABASE_URL=
PLATE8_SUPABASE_SERVICE_ROLE_KEY=
# Secret: Slate8 YouTube search. /api/yt is public (audit finding L2), so this quota can be spent by anyone.
YOUTUBE_API_KEY=

# ---- Header mark -----------------------------------------------------------------
# up = cyan, down = magenta, unset = neutral.
REVENUE_TREND=

# ---- Local scripts only (not read by the deployed site) ---------------------------
# scripts/stuttr: folder holding the Stuttr song library.
# STUTTR_LIBRARY=
# scripts/audit/live-check.sh and the Plate8 harness: site to test.
# BASE_URL=

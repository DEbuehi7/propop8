# ============================================================================
# .env.local  —  rename this file to .env.local in the repo root
# ============================================================================
#
# NEVER COMMIT THIS FILE. .env* is in .gitignore by default from
# create-next-app; confirm with:  git check-ignore -v .env.local
#
# The placeholders below are enough to get `npm run build` and `npm run dev`
# passing so you can look at the landing page. They are NOT enough to take a
# payment or send an email — swap them for real values before going live.
#
# Why placeholders and not blanks: several modules call createClient() at
# import time, and @supabase/supabase-js throws "supabaseUrl is required" on an
# empty string. That failure surfaces as an unrelated-looking build error.

# --- Supabase --------------------------------------------------------------
# Placeholder is a valid URL shape, which is all createClient checks at import.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Tally -----------------------------------------------------------------
# Form id is the last segment of your embed URL: tally.so/embed/<THIS>
# Left as-is, /audit renders its shell correctly and the iframe shows a Tally
# 404. That is fine for checking the page; the surrounding layout is yours.
NEXT_PUBLIC_TALLY_FORM_ID=YOUR_TALLY_FORM_ID
TALLY_SIGNING_SECRET=placeholder-signing-secret

# Leave false until you have tested whether Tally's webhook fires on
# submission or only after payment clears. False holds every intake for manual
# release; true issues an upload link automatically. Getting this wrong the
# other way hands $497 deliverables to people who abandoned at the card step.
TALLY_PAYMENT_ENABLED=false

# --- Resend ----------------------------------------------------------------
# from must be on a domain verified in Resend, or the API rejects the send.
RESEND_API_KEY=placeholder-resend-key
RESEND_FROM=PropOps8 <daniel@propops8.com>
AUDIT_NOTIFY_EMAIL=daniel@propops8.com

# ============================================================================
# For Netlify, set the same names under Site settings → Environment variables.
# NEXT_PUBLIC_BASE_URL becomes https://propops8.com there.
# SUPABASE_SERVICE_ROLE_KEY is server-only — never rename it with a
# NEXT_PUBLIC_ prefix, which would ship it to every visitor's browser.
# ============================================================================
